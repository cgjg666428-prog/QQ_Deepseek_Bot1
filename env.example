# 复制为 .env 后填写；不要提交 .env。
DEEPSEEK_API_KEY=
BOT_QQ=
# 需使用你的服务账户实际支持的模型名；支持图像输入时才能看图。
DEEPSEEK_MODEL=deepseek-flash
DEEPSEEK_BASE_URL=https://api.deepseek.com
NAPCAT_HTTP=http://127.0.0.1:3000
NAPCAT_WS=ws://127.0.0.1:3001
# 与 NapCat OneBot HTTP / 正向 WebSocket 的 Access Token 保持一致。
NAPCAT_TOKEN=
# 默认关闭，确认群友同意后可自行调整。
RANDOM_REPLY_CHANCE=0
# 可选：自己的 Netscape 格式 Cookie 文件，留空则不使用。
DOUYIN_COOKIES_FILE=
